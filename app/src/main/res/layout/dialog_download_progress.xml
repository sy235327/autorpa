<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingVertical="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/panelSurface"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/panelStroke"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/progressTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/progress_title"
                android:textColor="@color/textStrong"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/progressStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/textMuted"
                android:textSize="13sp"
                tools:text="Fetching archive and preparing deployment"
                xmlns:tools="http://schemas.android.com/tools" />

            <TextView
                android:id="@+id/progressMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:breakStrategy="balanced"
                android:lineSpacingExtra="1dp"
                android:maxLines="3"
                android:textColor="@color/textStrong"
                android:textSize="16sp"
                tools:text="Downloaded 115.50 MB / 163.21 MB"
                xmlns:tools="http://schemas.android.com/tools" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="18dp"
                app:indicatorColor="@color/navActive"
                app:trackColor="@color/inputSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/progressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_chip_soft"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/buttonTonalText"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="70%"
                    xmlns:tools="http://schemas.android.com/tools" />

                <TextView
                    android:id="@+id/progressHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/progress_hint"
                    android:textColor="@color/textMuted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>


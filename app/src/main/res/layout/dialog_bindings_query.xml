<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/license_bindings_query_hint"
        android:textColor="@color/textMuted"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/license_card_label"
        android:textColor="@color/textMuted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/dlgBindCodeInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/license_card_hint"
        android:inputType="textCapCharacters"
        android:maxLines="1"
        android:textColor="@color/textStrong"
        android:textColorHint="@color/textMuted"
        android:textSize="14sp" />
</LinearLayout>

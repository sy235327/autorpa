<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/consoleCardSurface" />
            <stroke
                android:width="1dp"
                android:color="@color/consoleCardStroke" />
        </shape>
    </item>

    <item
        android:gravity="top"
        android:height="2dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp" />
            <solid android:color="@color/consoleCardAccent" />
        </shape>
    </item>
</layer-list>
